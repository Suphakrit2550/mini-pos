{
  "name": "mini-pos",
  "version": "1.0.0",
  "description": "Mini POS web app for small shops (iPad-first)",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file=.env --watch server/index.js",
    "reset-password": "node --env-file=.env scripts/reset-password.js",
    "backup": "node --env-file=.env scripts/backup.js",
    "compress-images": "node --env-file=.env scripts/compress-product-images.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.4"
  }
}
